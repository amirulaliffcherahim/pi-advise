  "author": "amirulaliffcherahim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirulaliffcherahim/pi-advise.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "keywords": ["pi-package", "pi-extension", "advisor", "second-opinion", "discussion"],
  "files": ["LICENSE", "README.md", "src", "tsconfig.json"],
  "scripts": {
    "test": "node --test test/advice.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
